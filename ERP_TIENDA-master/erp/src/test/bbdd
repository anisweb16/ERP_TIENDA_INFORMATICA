-- Base de datos completa actualizada (sin dropear tablas existentes)
-- Crea la BBDD si no existe, asegura AUTO_INCREMENT en claves, define ENUMs
-- y añade datos de ejemplo (tienda tecnológica). Haz backup antes de ejecutar.

CREATE DATABASE IF NOT EXISTS erp_tienda
  DEFAULT CHARACTER SET utf8mb4
  DEFAULT COLLATE utf8mb4_general_ci;
USE erp_tienda;

-- =========================
-- Clientes y Proveedores (asegurar existencia y AUTO_INCREMENT)
-- =========================
CREATE TABLE IF NOT EXISTS Clientes (
  id_cliente INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(30) NOT NULL,
  direccion VARCHAR(100),
  telefono VARCHAR(12),
  email VARCHAR(50)
);

CREATE TABLE IF NOT EXISTS Proveedores (
  id_proveedor INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(50),
  direccion VARCHAR(100),
  telefono VARCHAR(20),
  email VARCHAR(100)
);

-- Si por alguna razón las tablas existieran sin AUTO_INCREMENT, intentamos modificar.
-- (Si la columna ya es AUTO_INCREMENT, ALTER no cambia nada.)
ALTER TABLE Clientes MODIFY id_cliente INT NOT NULL AUTO_INCREMENT PRIMARY KEY;
ALTER TABLE Proveedores MODIFY id_proveedor INT NOT NULL AUTO_INCREMENT PRIMARY KEY;

-- =========================
-- Productos, Empleados, Usuarios
-- =========================
CREATE TABLE IF NOT EXISTS productos (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    precio DOUBLE NOT NULL,
    stock INT NOT NULL
);

CREATE TABLE IF NOT EXISTS empleados (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    puesto VARCHAR(100) NOT NULL,
    salario DOUBLE NOT NULL,
    email VARCHAR(100)
);

CREATE TABLE IF NOT EXISTS usuarios (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    email VARCHAR(100) NOT NULL UNIQUE,
    password VARCHAR(100) NOT NULL
);

-- =========================
-- Pedidos (ventas) y detalle_pedido
-- Definimos estado y metodo_pago como ENUM desde el principio
-- Si la tabla ya existe con otros tipos, la convertimos a ENUM más abajo.
-- =========================
CREATE TABLE IF NOT EXISTS pedidos (
  id_pedido INT AUTO_INCREMENT PRIMARY KEY,
  id_cliente INT NOT NULL,
  fecha DATE NOT NULL,
  estado ENUM('COMPLETADO','PENDIENTE') NOT NULL DEFAULT 'PENDIENTE',
  metodo_pago ENUM('TARJETA','EFECTIVO','PAYPAL') NOT NULL DEFAULT 'EFECTIVO',
  FOREIGN KEY (id_cliente) REFERENCES Clientes(id_cliente)
);

CREATE TABLE IF NOT EXISTS detalle_pedido (
  id_detalle INT AUTO_INCREMENT PRIMARY KEY,
  id_pedido INT NOT NULL,
  id_producto INT NOT NULL,
  cantidad INT NOT NULL,
  importe_total DOUBLE NOT NULL,
  FOREIGN KEY (id_pedido) REFERENCES pedidos(id_pedido) ON DELETE CASCADE,
  FOREIGN KEY (id_producto) REFERENCES productos(id)
);

-- =========================
-- Compras y detalle_compra
-- Definimos estado y metodo_pago como ENUM desde el principio
-- =========================
CREATE TABLE IF NOT EXISTS compras (
  id_compra INT AUTO_INCREMENT PRIMARY KEY,
  id_proveedor INT NOT NULL,
  fecha DATE NOT NULL,
  estado ENUM('COMPLETADO','PENDIENTE') NOT NULL DEFAULT 'PENDIENTE',
  metodo_pago ENUM('TARJETA','EFECTIVO','PAYPAL') NOT NULL DEFAULT 'EFECTIVO',
  total DOUBLE DEFAULT 0,
  FOREIGN KEY (id_proveedor) REFERENCES Proveedores(id_proveedor)
);

CREATE TABLE IF NOT EXISTS detalle_compra (
  id_detalle_compra INT AUTO_INCREMENT PRIMARY KEY,
  id_compra INT NOT NULL,
  id_producto INT NOT NULL,
  cantidad INT NOT NULL,
  precio_unitario DOUBLE NOT NULL,
  importe_total DOUBLE NOT NULL,
  FOREIGN KEY (id_compra) REFERENCES compras(id_compra) ON DELETE CASCADE,
  FOREIGN KEY (id_producto) REFERENCES productos(id)
);

-- =========================
-- Si las tablas ya existían con VARCHAR en estado/metodo_pago,
-- convertimos las columnas a ENUM de forma segura.
-- (Esto no dropea tablas; convierte el tipo.)
-- =========================

-- Normalizar valores previos (si existen) para evitar errores al convertir.
-- Mapear variantes comunes a los valores exactos del ENUM.
UPDATE pedidos
SET estado = CASE
  WHEN UPPER(estado) IN ('COMPLETADO','COMPLETA','FINALIZADO','FIN','DONE') THEN 'COMPLETADO'
  ELSE 'PENDIENTE'
END
WHERE estado IS NULL OR UPPER(estado) NOT IN ('COMPLETADO','PENDIENTE');

UPDATE compras
SET estado = CASE
  WHEN UPPER(estado) IN ('COMPLETADO','COMPLETA','FINALIZADO','FIN','DONE') THEN 'COMPLETADO'
  ELSE 'PENDIENTE'
END
WHERE estado IS NULL OR UPPER(estado) NOT IN ('COMPLETADO','PENDIENTE');

UPDATE pedidos
SET metodo_pago = CASE
  WHEN LOWER(metodo_pago) IN ('tarjeta','card','credit card','card payment') THEN 'TARJETA'
  WHEN LOWER(metodo_pago) IN ('paypal') THEN 'PAYPAL'
  WHEN LOWER(metodo_pago) IN ('efectivo','cash') THEN 'EFECTIVO'
  ELSE 'EFECTIVO'
END
WHERE metodo_pago IS NULL OR UPPER(metodo_pago) NOT IN ('TARJETA','EFECTIVO','PAYPAL');

UPDATE compras
SET metodo_pago = CASE
  WHEN LOWER(metodo_pago) IN ('tarjeta','card','credit card','card payment') THEN 'TARJETA'
  WHEN LOWER(metodo_pago) IN ('paypal') THEN 'PAYPAL'
  WHEN LOWER(metodo_pago) IN ('efectivo','cash') THEN 'EFECTIVO'
  ELSE 'EFECTIVO'
END
WHERE metodo_pago IS NULL OR UPPER(metodo_pago) NOT IN ('TARJETA','EFECTIVO','PAYPAL');

-- Convertir columnas a ENUM (si ya eran ENUM esto no cambia)
ALTER TABLE pedidos
  MODIFY COLUMN estado ENUM('COMPLETADO','PENDIENTE') NOT NULL DEFAULT 'PENDIENTE',
  MODIFY COLUMN metodo_pago ENUM('TARJETA','EFECTIVO','PAYPAL') NOT NULL DEFAULT 'EFECTIVO';

ALTER TABLE compras
  MODIFY COLUMN estado ENUM('COMPLETADO','PENDIENTE') NOT NULL DEFAULT 'PENDIENTE',
  MODIFY COLUMN metodo_pago ENUM('TARJETA','EFECTIVO','PAYPAL') NOT NULL DEFAULT 'EFECTIVO';

-- =========================
-- Triggers para detalle_compra (recrear si existe)
-- =========================
DROP TRIGGER IF EXISTS trg_after_insert_detalle_compra;
DROP TRIGGER IF EXISTS trg_after_delete_detalle_compra;
DROP TRIGGER IF EXISTS trg_after_update_detalle_compra;

DELIMITER $$
CREATE TRIGGER trg_after_insert_detalle_compra
AFTER INSERT ON detalle_compra
FOR EACH ROW
BEGIN
  UPDATE productos
  SET stock = stock + NEW.cantidad
  WHERE id = NEW.id_producto;
END$$
DELIMITER ;

DELIMITER $$
CREATE TRIGGER trg_after_delete_detalle_compra
AFTER DELETE ON detalle_compra
FOR EACH ROW
BEGIN
  UPDATE productos
  SET stock = stock - OLD.cantidad
  WHERE id = OLD.id_producto;
END$$
DELIMITER ;

DELIMITER $$
CREATE TRIGGER trg_after_update_detalle_compra
AFTER UPDATE ON detalle_compra
FOR EACH ROW
BEGIN
  DECLARE diff INT;
  SET diff = NEW.cantidad - OLD.cantidad;
  UPDATE productos SET stock = stock + diff
  WHERE id = NEW.id_producto;
END$$
DELIMITER ;

